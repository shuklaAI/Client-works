# Using Next.js rewrite proxy /api/backend -> localhost:5000/api/v1
# NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Razorpay — get from https://dashboard.razorpay.com/app/keys (TEST key for dev)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX

# Supabase — get from https://app.supabase.com → Project Settings → API
# Used only if you add direct Supabase client calls in the frontend (optional)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
